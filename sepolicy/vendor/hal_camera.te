# Camera HAL on MT6795 needs access to MTK-specific camera devices
# and vendor blobs loaded via hw_get_module

allow hal_camera camera_isp_device:chr_file rw_file_perms;
allow hal_camera camera_sysram_device:chr_file rw_file_perms;
allow hal_camera camera_fdvt_device:chr_file rw_file_perms;
allow hal_camera camera_pipemgr_device:chr_file rw_file_perms;
allow hal_camera kd_camera_hw_device:chr_file rw_file_perms;
allow hal_camera kd_camera_flashlight_device:chr_file rw_file_perms;
allow hal_camera kd_camera_hw_bus2_device:chr_file rw_file_perms;
allow hal_camera mtk_jpeg_device:chr_file rw_file_perms;
allow hal_camera lens_device:chr_file rw_file_perms;
allow hal_camera CAM_CAL_DRV_device:chr_file rw_file_perms;
allow hal_camera dummy_cam_cal_device:chr_file rw_file_perms;
allow hal_camera seninf_device:chr_file rw_file_perms;

# Access to MTK vendor libraries loaded via hw_get_module
allow hal_camera vendor_file:file rx_file_perms;
allow hal_camera vendor_file:dir r_dir_perms;
allow hal_camera same_process_hal_file:file rx_file_perms;

# Needed for MTK camera pipeline via ION
allow hal_camera ion_device:chr_file rw_file_perms;
allow hal_camera gpu_device:chr_file rw_file_perms;

# MTK camera uses sysram
allow hal_camera self:capability sys_rawio;
allow hal_camera self:capability dac_override;
