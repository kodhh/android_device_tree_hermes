# Sensors HAL on MT6795 needs access to MTK sensor devices
allow hal_sensors sensor_device:chr_file rw_file_perms;
allow hal_sensors als_ps_device:chr_file rw_file_perms;
allow hal_sensors gsensor_device:chr_file rw_file_perms;
allow hal_sensors msensor_device:chr_file rw_file_perms;
allow hal_sensors gyroscope_device:chr_file rw_file_perms;
allow hal_sensors hwmsensor_device:chr_file rw_file_perms;
allow hal_sensors barometer_device:chr_file rw_file_perms;
allow hal_sensors humidity_device:chr_file rw_file_perms;
allow hal_sensors m_acc_misc_device:chr_file rw_file_perms;
allow hal_sensors m_mag_misc_device:chr_file rw_file_perms;
allow hal_sensors m_gyro_misc_device:chr_file rw_file_perms;
