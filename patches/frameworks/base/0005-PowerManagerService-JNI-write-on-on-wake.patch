     }
+    // Hermes uses the legacy earlysuspend power model: the fb/LCM panel only
+    // resumes when "on" is written to /sys/power/state. SystemSuspend only
+    // ever writes "mem", so the panel would stay stuck after a wake from
+    // earlysuspend. Writing "on" is a no-op when the device is already awake.
+    int fd = TEMP_FAILURE_RETRY(open("/sys/power/state", O_RDWR));
+    if (fd >= 0) {
+        TEMP_FAILURE_RETRY(write(fd, "on", sizeof("on") - 1));
+        close(fd);
+    } else {
+        ALOGE("Error opening /sys/power/state: %s", strerror(errno));
+    }
